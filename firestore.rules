rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Profiles
    match /profiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Quizzes
    match /quizzes/{quizId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.teacher_id == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.teacher_id == request.auth.uid;
    }

    // Rooms
    match /rooms/{roomId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if true;
      allow delete: if request.auth != null && resource.data.teacher_id == request.auth.uid;

      // Reactions subcollection
      match /reactions/{reactionId} {
        allow read, write: if true;
      }
    }

    // Room participants
    match /room_participants/{participantId} {
      allow read, write: if true;
    }

    // Quiz answers
    match /quiz_answers/{answerId} {
      allow read, write: if true;
    }
  }
}
